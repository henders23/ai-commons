---
import type { CollectionEntry } from 'astro:content';
import { types, themes, audiences } from '../site';
interface Props { resource: CollectionEntry<'resources'> }
const { resource } = Astro.props;
const d = resource.data;
const t = types[d.type as keyof typeof types];
---
<article class="card" data-slug={resource.id} data-type={d.type} data-themes={d.themes.join(' ')} data-audience={d.audience.join(' ')} data-title={d.title} data-summary={d.summary}>
  <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap">
    <span class={`badge type-${d.type}`}>{t.label}</span>
    {d.time && <span class="small muted">{d.time}</span>}
  </div>
  <h3><a href={`/library/${resource.id}`}>{d.title}</a></h3>
  <p>{d.summary}</p>
  <div class="meta">
    <span class="rating" data-rating-for={resource.id} aria-live="polite"></span>
    <span>{d.audience.map((a) => audiences[a as keyof typeof audiences].label).join(' · ')}</span>
  </div>
</article>
