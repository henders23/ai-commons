---
/* Fills every [data-rating-for] on the page with average and count from /api/ratings. */
---
<script>
  const nodes = Array.from(document.querySelectorAll<HTMLElement>('[data-rating-for]'));
  const slugs = [...new Set(nodes.map((n) => n.dataset.ratingFor!))];
  if (slugs.length) {
    fetch(`/api/ratings?slugs=${encodeURIComponent(slugs.join(','))}`)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((data: Record<string, { avg: number; count: number }>) => {
        for (const n of nodes) {
          const s = data[n.dataset.ratingFor!];
          if (!s || !s.count) continue;
          const full = Math.round(s.avg);
          n.innerHTML = `<span class="stars" aria-hidden="true">${'★'.repeat(full)}${'☆'.repeat(5 - full)}</span> <span>${s.avg.toFixed(1)} · ${s.count} rating${s.count === 1 ? '' : 's'}</span>`;
          n.setAttribute('aria-label', `Rated ${s.avg.toFixed(1)} out of 5 by ${s.count}`);
        }
      })
      .catch(() => { /* ratings are a nicety; the page works without them */ });
  }
</script>
