---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" searchable={false}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page is not here.</h1>
      <p class="lede">The Commons was rebuilt in 2026 and older links have moved. Try the library.</p>
      <p><a class="btn primary" href="/library">Go to the library</a></p>
    </div>
  </section>
</Base>
