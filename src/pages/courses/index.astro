---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site';
import { fmtMonth, dayOf } from '../../lib/format';
const all = (await getCollection('courses', ({ data }) => !data.draft));
const now = Date.now();
const upcoming = all.filter((c) => (c.data.ends ?? c.data.starts).getTime() >= now).sort((a, b) => a.data.starts.getTime() - b.data.starts.getTime());
const past = all.filter((c) => (c.data.ends ?? c.data.starts).getTime() < now).sort((a, b) => b.data.starts.getTime() - a.data.starts.getTime());
---
<Base title="Courses and events" description="Courses, workshops and sessions on AI in EAP: dates, format, who they are for, and how to register.">
  <section class="hero" style="padding-bottom:1rem">
    <div class="wrap">
      <p class="eyebrow">Courses and events</p>
      <h1>Learn together.</h1>
      <p class="lede">Structured sessions on AI in EAP, run by the Commons. Materials from past courses stay here afterwards.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0.5rem">
    <div class="wrap">
      <h2>Upcoming</h2>
      {upcoming.length === 0 ? (
        <div class="empty">
          <p><strong>Nothing is scheduled right now.</strong></p>
          <p class="muted">New courses are announced here first. <a href={`mailto:${site.contributeEmail}?subject=${encodeURIComponent('Tell me about the next course')}`}>Email to be told</a> when the next one is set.</p>
        </div>
      ) : (
        <div>
          {upcoming.map((c) => (
            <article class="course">
              <div class="date">{dayOf(c.data.starts)}<small>{fmtMonth(c.data.starts)}</small></div>
              <div>
                <h3><a href={`/courses/${c.id}`}>{c.data.title}</a></h3>
                <p>{c.data.summary}</p>
                <p class="small muted">{c.data.format}{c.data.place ? ` · ${c.data.place}` : ''} · {c.data.audience}</p>
                {c.data.registerUrl && <a class="btn primary" href={c.data.registerUrl} target="_blank" rel="noopener">Register ↗</a>}
              </div>
            </article>
          ))}
        </div>
      )}
      {past.length > 0 && (
        <>
          <h2 style="margin-top:3rem">Past courses</h2>
          <div>
            {past.map((c) => (
              <article class="course">
                <div class="date">{dayOf(c.data.starts)}<small>{fmtMonth(c.data.starts)}</small></div>
                <div>
                  <h3><a href={`/courses/${c.id}`}>{c.data.title}</a></h3>
                  <p>{c.data.summary}</p>
                  {c.data.materials.length > 0 && <p class="small"><a href={`/courses/${c.id}`}>Materials from this course</a></p>}
                </div>
              </article>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</Base>
