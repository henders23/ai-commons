---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const pathways = (await getCollection('pathways', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Pathways" description="Curated sequences through the AI Commons for EAP: a first team conversation, a centre position on AI, rethinking assessment, talking to students.">
  <section class="hero" style="padding-bottom:1rem">
    <div class="wrap">
      <p class="eyebrow">Pathways</p>
      <h1>Start from the situation you are in.</h1>
      <p class="lede">A pathway strings a few resources into an order, with a note on what to do with each. Follow one alone, or use it as the plan for a session with colleagues.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0.5rem">
    <div class="wrap grid">
      {pathways.map((p) => (
        <article class="card">
          <span class="eyebrow">{p.data.forWhom}</span>
          <h3><a href={`/pathways/${p.id}`}>{p.data.title}</a></h3>
          <p>{p.data.tagline}</p>
          <div class="meta"><span>{p.data.steps.length} steps{p.data.duration ? ` · ${p.data.duration}` : ''}</span></div>
        </article>
      ))}
    </div>
  </section>
</Base>
