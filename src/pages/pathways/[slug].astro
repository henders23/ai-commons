---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { types } from '../../site';

export async function getStaticPaths() {
  const pathways = await getCollection('pathways', ({ data }) => !data.draft);
  const resources = await getCollection('resources', ({ data }) => !data.draft);
  return pathways.map((p) => ({ params: { slug: p.id }, props: { pathway: p, resources } }));
}
const { pathway, resources } = Astro.props;
const d = pathway.data;
const { Content } = await render(pathway);
const byId = Object.fromEntries(resources.map((r) => [r.id, r]));
---
<Base title={d.title} description={d.tagline} ogType="article">
  <section class="hero" style="padding-bottom:0.5rem">
    <div class="wrap">
      <p class="eyebrow"><a href="/pathways" style="color:inherit;text-decoration:none">Pathways</a> / {d.forWhom}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.tagline}</p>
      {d.duration && <p class="muted small">{d.steps.length} steps · {d.duration}</p>}
    </div>
  </section>
  <section class="section" style="padding-top:1rem">
    <div class="wrap resource">
      <div>
        <div class="prose" style="margin-bottom:2rem"><Content /></div>
        <ol class="steps">
          {d.steps.map((s) => {
            const r = s.resource ? byId[s.resource] : undefined;
            return (
              <li class="step">
                <div>
                  {r ? (
                    <>
                      <span class={`badge type-${r.data.type}`}>{types[r.data.type as keyof typeof types].label}</span>
                      <h3 style="margin-top:0.4rem"><a href={`/library/${r.id}`}>{r.data.title}</a></h3>
                    </>
                  ) : (
                    <>
                      <span class="coming">Coming to the Commons</span>
                      <h3 style="margin-top:0.2rem">{s.title ?? s.resource}</h3>
                    </>
                  )}
                  <p>{s.note}</p>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
      <aside data-pagefind-ignore>
        <div class="panel">
          <h4>How to use a pathway</h4>
          <p class="small" style="margin:0 0 0.6rem">Work through the steps in order. Each links to a resource with its own download and notes.</p>
          <p class="small muted" style="margin:0">Steps marked <em>coming</em> are planned but not yet published. <a href="/contribute">Contribute one</a> if you have it.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
